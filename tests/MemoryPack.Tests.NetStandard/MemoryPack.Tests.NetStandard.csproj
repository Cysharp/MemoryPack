<Project Sdk="Microsoft.NET.Sdk">

    <!-- Runs the tests of MemoryPack.Tests against the netstandard2.1 build of the libraries. -->

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <RootNamespace>MemoryPack.Tests</RootNamespace>
        <!-- Remove NET*_OR_GREATER symbols so that test code and generated code take the same path as netstandard2.1 consumers. -->
        <DisableImplicitFrameworkDefines>true</DisableImplicitFrameworkDefines>
    </PropertyGroup>

    <ItemGroup>
        <!-- Source generator tests do not depend on the target framework of the libraries. -->
        <TestsExcludedFromNetStandard Include="..\MemoryPack.Tests\SourceGeneratorTests\**\*.cs" />
        <TestsExcludedFromNetStandard Include="..\MemoryPack.Tests\Utils\CSharpGeneratorRunner.cs" />
        <!-- Only checks the struct layout of the runtime, which is the same as MemoryPack.Tests. -->
        <TestsExcludedFromNetStandard Include="..\MemoryPack.Tests\MemoryLayoutTest.cs" />

        <Compile Include="..\MemoryPack.Tests\**\*.cs" Exclude="..\MemoryPack.Tests\obj\**;..\MemoryPack.Tests\bin\**;@(TestsExcludedFromNetStandard)" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="FluentAssertions" Version="6.7.0" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.4.0" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
        <PackageReference Include="RandomFixtureKit" Version="1.0.1" />
        <PackageReference Include="xunit" Version="2.4.2" />
        <PackageReference Include="xunit.runner.visualstudio" Version="2.4.5">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\MemoryPack.Core\MemoryPack.Core.csproj" SetTargetFramework="TargetFramework=netstandard2.1" />
        <ProjectReference Include="..\..\src\MemoryPack.Generator\MemoryPack.Generator.csproj">
            <OutputItemType>Analyzer</OutputItemType>
            <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
        </ProjectReference>
        <ProjectReference Include="..\..\src\MemoryPack.Streaming\MemoryPack.Streaming.csproj" SetTargetFramework="TargetFramework=netstandard2.1" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit" />
        <Using Include="Xunit.Abstractions" />
        <Using Include="FluentAssertions" />
        <Using Include="MemoryPack" />
        <Using Include="MemoryPack.Tests.Utils" />
    </ItemGroup>
</Project>
